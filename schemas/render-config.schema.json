{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "render-config",
  "type": "object",
  "properties": {
    "engine": {
      "enum": [
        "html",
        "remotion"
      ]
    },
    "composition": {
      "type": "string",
      "minLength": 1
    },
    "width": {
      "type": "integer",
      "minimum": 1
    },
    "height": {
      "type": "integer",
      "minimum": 1
    },
    "fps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120
    },
    "duration_frames": {
      "type": "integer",
      "minimum": 1
    },
    "codec": {
      "enum": [
        "h264",
        "prores",
        "vp9"
      ]
    },
    "source_files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    }
  },
  "required": [
    "engine",
    "composition",
    "width",
    "height",
    "fps",
    "duration_frames",
    "codec",
    "source_files"
  ],
  "additionalProperties": false
}
