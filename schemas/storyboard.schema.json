{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "storyboard",
  "type": "object",
  "properties": {
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "composition": {
            "type": "string",
            "minLength": 1
          },
          "targets": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "focus": {
            "type": "string",
            "minLength": 1
          },
          "transition": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "composition",
          "targets",
          "focus",
          "transition"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "scenes"
  ],
  "additionalProperties": false
}
