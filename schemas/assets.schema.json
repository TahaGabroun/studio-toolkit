{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "assets",
  "type": "object",
  "properties": {
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "path",
          "sha256",
          "license",
          "source"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "assets"
  ],
  "additionalProperties": false
}
