{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "production-plan",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "director_version": {
      "type": "string",
      "minLength": 1
    },
    "input_fingerprint": {
      "type": "string",
      "minLength": 1
    },
    "brief": {
      "type": "object",
      "properties": {
        "idea": {
          "type": "string",
          "minLength": 1
        },
        "audience": {
          "type": "string",
          "minLength": 1
        },
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "idea",
        "audience",
        "goal",
        "scope",
        "assumptions"
      ],
      "additionalProperties": false
    },
    "master": {
      "type": "object",
      "properties": {
        "skill": {
          "type": "string",
          "minLength": 1
        },
        "engine_family": {
          "enum": [
            "html",
            "remotion"
          ]
        },
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "adaptations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "skill",
        "engine_family",
        "profile",
        "reason",
        "adaptations"
      ],
      "additionalProperties": false
    },
    "formats": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "width": {
            "type": "integer",
            "minimum": 2
          },
          "height": {
            "type": "integer",
            "minimum": 2
          },
          "fps": {
            "type": "integer",
            "minimum": 1
          },
          "duration_frames": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "width",
          "height",
          "fps",
          "duration_frames"
        ],
        "additionalProperties": false
      }
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "skill": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "skill",
          "role",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "scene_routes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "master_skill": {
            "type": "string",
            "minLength": 1
          },
          "rules": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "purpose",
          "skills",
          "master_skill",
          "rules"
        ],
        "additionalProperties": false
      }
    },
    "narration": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "generate",
            "provided",
            "none"
          ]
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "rule": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "mode",
        "provider",
        "path",
        "rule"
      ],
      "additionalProperties": false
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "phase": {
            "type": "string",
            "minLength": 1
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "required_artifacts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "criteria": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "procedure": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "phase",
          "skills",
          "required_artifacts",
          "criteria",
          "procedure"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "before_gate": {
            "type": "string",
            "minLength": 1
          },
          "requirement": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "before_gate",
          "requirement"
        ],
        "additionalProperties": false
      }
    },
    "reuse_policy": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "quality_policy": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "director_version",
    "input_fingerprint",
    "brief",
    "master",
    "formats",
    "routes",
    "scene_routes",
    "narration",
    "gates",
    "conditions",
    "reuse_policy",
    "quality_policy"
  ],
  "additionalProperties": false
}
